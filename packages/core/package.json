{
  "name": "@arc-porter/core",
  "version": "0.1.0",
  "description": "Rule engine that reads Solidity source and flags code that breaks or behaves differently on Arc",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solidity-parser/parser": "^0.20.2"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "tsup": "^9.0.0"
  }
}

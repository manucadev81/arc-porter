              "name": "blob-opcodes",
              "shortDescription": {
                "text": "Blob opcodes return fixed values on Arc"
              },
              "fullDescription": {
                "text": "Arc does not support blob transactions. BLOBHASH always returns 0 and BLOBBASEFEE always returns 1, so code that reads blobhash(i) or block.blobbasefee gets constants instead of chain data."
              },
              "help": {
                "text": "Remove the dependency on blob data; Arc rejects type-3 transactions at the mempool.\\n\\nSource: https://docs.arc.io/arc/references/evm-differences#execution-and-opcode-differences"
              },
              "helpUri": "https://docs.arc.io/arc/references/evm-differences#execution-and-opcode-differences",

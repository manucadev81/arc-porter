                "precision": "medium"
              }
            },
            {
              "id": "AP010",
              "name": "zero-balance-check",
              "shortDescription": {
                "text": "balanceOf() == 0 does not mean the balance is empty"
              },
              "fullDescription": {
                "text": "The ERC-20 balanceOf on Arc truncates anything below 1e-6 USDC, so it reads 0 while the native balance still holds dust. Logic that treats balanceOf(...) == 0 as \\"empty\\" can be wrong."
              },
              "help": {
                "text": "Compare against the amount you need (balanceOf(x) >= amount) or read the native balance when exactness matters.\\n\\nSource: https://docs.arc.io/arc/tutorials/porting-contracts-to-arc#steps"
              },
              "helpUri": "https://docs.arc.io/arc/tutorials/porting-contracts-to-arc#steps",

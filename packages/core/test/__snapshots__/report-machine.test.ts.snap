                  "portability"
                ],
                "security-severity": "5.0",
                "precision": "high"
              }
            },
            {
              "id": "AP009",
              "name": "native-balance-sweep",
              "shortDescription": {
                "text": "Native sweep in a contract that also holds ERC-20 USDC"
              },
              "fullDescription": {
                "text": "On Arc the ERC-20 USDC a contract holds is its native balance. A function that sends address(this).balance also moves the users' ERC-20 USDC, so a contract that handles tokens must not sweep its native balance."
              },
              "help": {
                "text": "Track what the contract owes in storage and transfer only the surplus, or remove the sweep from contracts that custody ERC-20 USDC.\\n\\nSource: https://docs.arc.io/arc/tutorials/porting-contracts-to-arc#steps"
              },
              "helpUri": "https://docs.arc.io/arc/tutorials/porting-contracts-to-arc#steps",

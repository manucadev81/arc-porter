                "security-severity": "5.0",
                "precision": "medium"
              }
            },
            {
              "id": "AP008",
              "name": "native-asset-sentinel",
              "shortDescription": {
                "text": "EIP-7528 native-asset sentinel must not alias Arc's USDC"
              },
              "fullDescription": {
                "text": "DeFi SDKs use 0xEeee...EEeE as a stand-in for native ETH in routing tables. On Arc the native asset is USDC and already has an ERC-20 interface, so aliasing the sentinel to the USDC address conflates native value transfers with ERC-20 transfers."
              },
              "help": {
                "text": "Use the USDC ERC-20 address 0x3600000000000000000000000000000000000000 directly instead of a native-asset sentinel.\\n\\nSource: https://docs.arc.io/arc/concepts/stablecoin-native-model#usdc-as-the-native-token"
              },
              "helpUri": "https://docs.arc.io/arc/concepts/stablecoin-native-model#usdc-as-the-native-token",
